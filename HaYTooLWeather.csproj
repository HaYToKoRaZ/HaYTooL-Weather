<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>HaYTooLWeather</AssemblyName>
    <RootNamespace>HaYTooLWeather</RootNamespace>
    <Version>3.0.0</Version>
    <Authors>HaYTo</Authors>
    <Company>HaYTooL</Company>
    <Product>HaYTooL Weather</Product>
    <Description>Windows System Tray Weather Application by HaYTo</Description>
    <ApplicationIcon>app.ico</ApplicationIcon>
    
    <!-- Release derlemede PDB dosyasını üretme (Temiz çıktı için) -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

</Project>
